<?xml version='1.0' encoding='utf-8'?>
<!--
  WiX template for planebotcli v1.4.x MSI.

  Generated by hand because the cargo-dist 0.32 / 0.33 WiX-key detection
  on this workspace layout was broken (see PLANECLI-63 task notes), so
  cargo-wix runs directly via `.github/workflows/release.yml`'s
  `build-windows-msi` job.

  Two GUIDs (UpgradeCode, path component) are stable across releases.
  Bump them only if the install path or product family changes — once
  an UpgradeCode is shipped, changing it forces users to uninstall
  the old version before the new one can take over.

  Binary path assumes `cargo wix` is invoked from the package root
  with `target/x86_64-pc-windows-msvc/release/planebotcli.exe` present.
  The `build-windows-msi` job runs `cargo build` (release flag,
  x86_64-pc-windows-msvc target) before `cargo wix` so this path is
  filled.

  NB: an earlier draft of this comment said "cargo build
  release-flag target-flag" which WiX 3's strict-XML parser rejects:
  the literal sequence "double-dash" inside an XML comment ends the
  comment, and candle errors with CNDL0104. This file avoids the
  sequence entirely.
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/main'>

  <Product
    Name='planebotcli'
    Version='$(var.Version)'
    Manufacturer='planebotcli'
    UpgradeCode='E5552628-8F75-4A24-B783-84456E3D5561'>

    <Package
      InstallerVersion='300'
      Compressed='yes'
      InstallScope='perMachine' />

    <MediaTemplate EmbedCab='yes' />

    <Feature Id='MainFeature' Title='planebotcli' Level='1'>
      <ComponentGroupRef Id='ProductComponents' />
    </Feature>

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFiles64Folder' Name='PFiles'>
        <Directory Id='INSTALLDIR' Name='planebotcli'>
          <Component Id='MainExecutable' Guid='298296AC-5DC0-4781-9DA4-227FEC7C1D61' Win64='yes'>
            <File Source='target/x86_64-pc-windows-msvc/release/planebotcli.exe' />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <ComponentGroup Id='ProductComponents'>
      <ComponentRef Id='MainExecutable' />
    </ComponentGroup>

  </Product>
</Wix>
